# Line-ending policy: Linux-executed scripts MUST be LF (a CRLF shebang
# breaks with "bad interpreter" on Linux). Windows scripts stay CRLF.
* text=auto
linux/wlt   text eol=lf
*.sh        text eol=lf
*.py        text eol=lf
*.pyw       text eol=lf
*.md        text eol=lf
*.json      text eol=lf
*.ps1       text eol=crlf
*.cmd       text eol=crlf
*.vbs       text eol=crlf
*.png       binary
*.zip       binary
*.exe       binary