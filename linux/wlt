def cmd_job_start(args):
    body = {"cmd": " ".join(args.cmd), "timeout": args.timeout}
    for k in ("shell", "cwd", "request_id", "resource", "note"):
        v = getattr(args, k, None)
        if v:
            body[k] = v
    res = api("POST", "/job/start", body)
    if not res.get("ok"):
        die(f"{res.get('error_code')}: {res.get('detail', '')}", 126)
    if args.json:
        print(json.dumps(res, indent=2, ensure_ascii=False))
        return
    print(f"job {res.get('id')}  state={res.get('state')}"
          + ("  (dedup: existing job returned)" if res.get("dedup") else ""))
    if args.wait and args.wait > 0:
        st = api("POST", "/job/status", {"job_id": res["id"], "wait": args.wait})
        _exit_for_job(st)


def _exit_for_job(st):
    state = st.get("state")
    print(f"job {st.get('id')}  state={state}  exit_code={st.get('exit_code')}  "
          f"error={st.get('error_code')}")
    if state in ("QUEUED", "RUNNING"):
        die("client wait expired; job still running (state unknown, NOT a failure)", 124)
    if state == "CANCELLED":
        sys.exit(130)
    if state in ("LOST", "SPAWN_ERROR"):
        sys.exit(126)
    if state == "TIMEOUT":
        sys.exit(124)
    rc = st.get("exit_code")
    sys.exit(0 if rc == 0 else (rc or 1))


def cmd_job_status(args):
    st = api("POST", "/job/status", {"job_id": args.id, "wait": args.wait})
    if args.json:
        print(json.dumps(st, indent=2, ensure_ascii=False))
        return
    _exit_for_job(st)


def cmd_job_logs(args):
    res = api("POST", "/job/logs", {"job_id": args.id, "which": args.which,
                                    "since": args.since, "limit": args.limit})
    sys.stdout.write(res.get("text", ""))
    print(f"\n[since={res.get('since')} next={res.get('next')} total={res.get('total')}]",
          file=sys.stderr)


def cmd_job_result(args):
    res = api("POST", "/job/result", {"job_id": args.id})
    if args.json:
        print(json.dumps(res, indent=2, ensure_ascii=False))
        return
    print(f"job {res.get('id')}  state={res.get('state')}  exit_code={res.get('exit_code')}")
    for which in ("stdout", "stderr"):
        s = res.get(which, {})
        print(f"--- {which} ({s.get('bytes')} bytes, sha256={s.get('sha256','')[:16]}...) ---")
        if s.get("text"):
            print(s["text"])


def cmd_job_cancel(args):
