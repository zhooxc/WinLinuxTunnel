#!/usr/bin/env python3
"""wlt command line (Linux side) - single-file, standard library only.

The Windows host dials out and opens a reverse tunnel, so this machine only
talks to http://127.0.0.1:<WLT_TUNNEL_PORT>. Nothing listens on the network
here and no root/sudo is used.

This file is ALSO the authoritative rule validator and the only place that
rewrites the tunnel key's authorized_keys options. The Windows GUI/agent
pushes rule sets here via `wlt tunnel import` (over the management key) so
validation logic exists exactly once.

Config:  $WLT_HOME/bridge.env  (default ~/.wlt/bridge.env, mode 0600)
  WLT_AGENT_TOKEN   bearer token
  WLT_TUNNEL_PORT   local end of the control tunnel (default 18081)
Rule store: $WLT_HOME/tunnels.json   (source of truth)
SSH dir:    $WLT_SSH_DIR (default ~/.ssh)

Python 3.8+. ASCII comments.
"""

import argparse
import hashlib
import json
import os
import re
import socket
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

VERSION = "0.1.0"

# Force UTF-8 output regardless of console locale (avoids mojibake on Windows
# GBK consoles; Linux terminals are already UTF-8).
for _stream in (sys.stdout, sys.stderr):
    try:
        _stream.reconfigure(encoding="utf-8")
    except (AttributeError, ValueError):
        pass

HOME = Path(os.environ.get("WLT_HOME", str(Path.home() / ".wlt")))
SSH_DIR = Path(os.environ.get("WLT_SSH_DIR", str(Path.home() / ".ssh")))
ENV_FILE = HOME / "bridge.env"
RULES_FILE = HOME / "tunnels.json"
AUDIT_FILE = HOME / "tunnels.audit.jsonl"
TUNNEL_PUB = HOME / "tunnel_ed25519.pub"
AK_FILE = SSH_DIR / "authorized_keys"

LOOPBACK = {"127.0.0.1", "::1", "localhost"}


# --------------------------------------------------------------------------
# Config & HTTP
# --------------------------------------------------------------------------

def load_env():
    conf = {}
    if ENV_FILE.exists():
        for line in ENV_FILE.read_text(encoding="utf-8").splitlines():
            line = line.strip().replace("\r", "")
            if not line or line.startswith("#") or "=" not in line:
                continue
            k, v = line.split("=", 1)
            conf[k.strip()] = v.strip()
    for k in ("WLT_AGENT_TOKEN", "WLT_TUNNEL_PORT", "WLT_AGENT_PORT", "WLT_CONNECT_PORT"):
        if os.environ.get(k):
            conf[k] = os.environ[k]
    return conf


CONF = load_env()
# Connection port: normally the Linux end of the control tunnel (WLT_TUNNEL_PORT).
# WLT_CONNECT_PORT overrides it for direct local debugging (talk to the agent
# port without a tunnel). The CONTROL port identity stays WLT_TUNNEL_PORT so
# reserved-port validation and permitlisten are correct regardless.
PORT = CONF.get("WLT_CONNECT_PORT", CONF.get("WLT_TUNNEL_PORT", "18081"))
BASE = f"http://127.0.0.1:{PORT}"
TOKEN = CONF.get("WLT_AGENT_TOKEN", "")
TIMEOUT = float(os.environ.get("WLT_TIMEOUT", "120"))


def die(msg, code=1):
    print(f"wlt: {msg}", file=sys.stderr)
    sys.exit(code)


def api(method, path, body=None):
    """Call the agent. Returns parsed JSON. Exit 125 when unreachable."""
    url = BASE + path
    data = None
    headers = {"Authorization": f"Bearer {TOKEN}"}
    if body is not None:
        data = json.dumps(body, ensure_ascii=False).encode("utf-8")
        headers["Content-Type"] = "application/json; charset=utf-8"
    req = urllib.request.Request(url, data=data, headers=headers, method=method)
    try:
        with urllib.request.urlopen(req, timeout=TIMEOUT) as resp:
            return json.loads(resp.read().decode("utf-8"))
    except urllib.error.HTTPError as exc:
        raw = exc.read().decode("utf-8", errors="replace")
        try:
            detail = json.loads(raw)
        except ValueError:
            detail = {"error": raw}
        die(f"{path}: HTTP {exc.code}: {detail.get('error', '')} {detail.get('detail', '')}", 2)
    except urllib.error.URLError as exc:
        die(f"cannot reach {BASE} ({exc.reason}) - is the Windows side running? try: wlt status", 125)
    except socket.timeout:
        die(f"request to {BASE} timed out after {TIMEOUT}s", 124)


# --------------------------------------------------------------------------
# Rule model & validation (authoritative)
# --------------------------------------------------------------------------

def norm_hostport(s, default_host="127.0.0.1"):
    """Normalize '3080' / 'host:3080' -> 'host:3080'. Raises ValueError."""
    s = str(s).strip()
    if not s:
        raise ValueError("empty host:port")
    if ":" in s:
        host, port = s.rsplit(":", 1)
        host = host or default_host
    else:
        host, port = default_host, s
    if not re.fullmatch(r"[A-Za-z0-9_.\-]+", host):
        raise ValueError(f"bad host: {host}")
    if not port.isdigit() or not (1 <= int(port) <= 65535):
        raise ValueError(f"bad port: {port}")
    return f"{host}:{port}"


def is_loopback(hostport):
    return hostport.rsplit(":", 1)[0] in LOOPBACK


def validate_rules(rules, control_port):
    """Validate + normalize a full rule list. Raises ValueError with a clear
    message. Returns the normalized list."""
    if not isinstance(rules, list):
        raise ValueError("rules must be a list")
    seen_ids = set()
    seen_listen = set()
    out = []
    for i, r in enumerate(rules):
        if not isinstance(r, dict):
            raise ValueError(f"rule #{i}: must be an object")
        rid = str(r.get("id") or "").strip()
        if not rid:
            raise ValueError(f"rule #{i}: missing id")
        if rid in seen_ids:
            raise ValueError(f"duplicate rule id: {rid}")
        seen_ids.add(rid)
        d = r.get("dir")
        if d not in ("L", "R"):
            raise ValueError(f"rule {rid}: dir must be 'L' or 'R'")
        try:
            listen = norm_hostport(r.get("listen", ""))
            target = norm_hostport(r.get("target", ""))
        except ValueError as exc:
            raise ValueError(f"rule {rid}: {exc}")
        if d == "R" and listen.rsplit(":", 1)[1] == str(control_port):
            raise ValueError(f"rule {rid}: listen port {control_port} is reserved for the control tunnel")
        key = (d, listen)
        if key in seen_listen:
            raise ValueError(f"rule {rid}: duplicate {d} listen {listen}")
        seen_listen.add(key)
        if not is_loopback(listen) and not r.get("lan"):
            raise ValueError(f"rule {rid}: non-loopback listen {listen} needs --lan (explicit opt-in)")
        out.append({
            "id": rid, "dir": d, "listen": listen, "target": target,
            "enabled": bool(r.get("enabled", True)),
            "lan": bool(r.get("lan", False)),
            "note": str(r.get("note", "")),
        })
    return out


def load_store():
    if RULES_FILE.exists():
        try:
            return json.loads(RULES_FILE.read_text(encoding="utf-8")).get("rules", [])
        except (OSError, ValueError):
            die(f"corrupt rule store: {RULES_FILE}")
    return []


def save_store(rules):
    HOME.mkdir(parents=True, exist_ok=True)
    tmp = RULES_FILE.with_suffix(".tmp")
    tmp.write_text(json.dumps({"version": 1, "rules": rules}, indent=2, ensure_ascii=False),
                   encoding="utf-8")
    os.replace(tmp, RULES_FILE)
    try:
        os.chmod(RULES_FILE, 0o600)
    except OSError:
        pass


def audit(action, rules, source="cli"):
    try:
        HOME.mkdir(parents=True, exist_ok=True)
        with open(AUDIT_FILE, "a", encoding="utf-8") as fh:
            fh.write(json.dumps({"ts": time.strftime("%Y-%m-%dT%H:%M:%S"),
                                 "action": action, "source": source,
                                 "ids": [r.get("id") for r in rules]}, ensure_ascii=False) + "\n")
    except OSError:
        pass


# --------------------------------------------------------------------------
# authorized_keys rewrite (the security core)
# --------------------------------------------------------------------------

def tunnel_pub_blob():
    if not TUNNEL_PUB.exists():
        die(f"tunnel public key missing: {TUNNEL_PUB} - run the installer first")
    parts = TUNNEL_PUB.read_text(encoding="utf-8").split()
    if len(parts) < 2:
        die(f"malformed tunnel public key: {TUNNEL_PUB}")
    return parts[0], parts[1]  # keytype, base64 blob


def build_ak_options(rules, control_port):
    """restrict,port-forwarding + paired permitlisten/permitopen lists.

    HARD CONSTRAINTS (verified against OpenSSH semantics):
      * permitopen scopes -L targets; permitlisten scopes -R listens.
      * restrict,port-forwarding opens BOTH directions, so BOTH lists must
        always be present or the unlisted direction is wide open.
      * 'restrict' must come first.
      * With no -L rules, a dummy permitopen (discard port 9) seals that side.
    """
    listens = [f"127.0.0.1:{control_port}"]   # control tunnel always allowed
    opens = []
    for r in rules:
        if not r.get("enabled", True):
            continue
        if r["dir"] == "R":
            listens.append(r["listen"])
        else:
            opens.append(r["target"])
    if not opens:
        opens.append("127.0.0.1:9")           # dummy: seal -L direction
    # de-dup, preserve order
    listens = list(dict.fromkeys(listens))
    opens = list(dict.fromkeys(opens))
    opts = ["restrict", "port-forwarding"]
    opts += [f'permitlisten="{x}"' for x in listens]
    opts += [f'permitopen="{x}"' for x in opens]
    return ",".join(opts)


def rewrite_authorized_keys(rules, control_port):
    """Replace the options on the tunnel key line; leave all other lines be.
    Atomic write, mode 0600."""
    keytype, blob = tunnel_pub_blob()
    opts = build_ak_options(rules, control_port)
    new_line = f"{opts} {keytype} {blob} wlt-tunnel"
    lines = []
    if AK_FILE.exists():
        lines = AK_FILE.read_text(encoding="utf-8").splitlines()
    found = False
    for i, ln in enumerate(lines):
        # The key blob is the unique anchor; options/comment may vary.
        if blob in ln.split():
            lines[i] = new_line
            found = True
    if not found:
        lines.append(new_line)
    SSH_DIR.mkdir(parents=True, exist_ok=True)
    tmp = AK_FILE.with_suffix(".tmp")
    tmp.write_text("\n".join(lines) + "\n", encoding="utf-8")
    os.replace(tmp, AK_FILE)
    try:
        os.chmod(AK_FILE, 0o600)
        os.chmod(SSH_DIR, 0o700)
    except OSError:
        pass
    return opts


def apply_to_windows(rules):
    """Push the rule set to the agent (it restarts the user tunnel)."""
    return api("POST", "/tunnels/apply", {"rules": rules})


def commit_rules(rules, action, source="cli", push=True):
    """Validate -> persist -> rewrite authorized_keys -> audit -> push."""
    control_port = CONF.get("WLT_TUNNEL_PORT", "18081")
    rules = validate_rules(rules, control_port)
    save_store(rules)
    opts = rewrite_authorized_keys(rules, control_port)
    audit(action, rules, source)
    result = apply_to_windows(rules) if push else {"ok": True, "pushed": False}
    return rules, opts, result


# --------------------------------------------------------------------------
# Output helpers
# --------------------------------------------------------------------------

def print_rule_table(states):
    if not states:
        print("  (no rules)")
        return
    print(f"  {'ID':<14}{'DIR':<5}{'LISTEN':<24}{'TARGET':<24}{'STATE':<7}NOTE")
    for r in states:
        print(f"  {r.get('id',''):<14}{r.get('dir',''):<5}"
              f"{r.get('listen',''):<24}{r.get('target',''):<24}"
              f"{r.get('state','?'):<7}{r.get('note','')}")


def show_apply_result(result):
    if not result.get("ok"):
        print(f"wlt: apply reported a problem: {result.get('error') or result.get('note','')}",
              file=sys.stderr)
    print_rule_table(result.get("rules", []))


