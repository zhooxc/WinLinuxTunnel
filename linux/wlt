def cmd_shot(args):
    body = {"mode": "b64"}
    if args.monitor is not None:
        body["monitor"] = args.monitor
    if args.region:
        body["region"] = [int(v) for v in args.region.split(",")]
    if args.window:
        body["window"] = args.window
    res = api("POST", "/screenshot", body)
    if args.path_only:
        print(f"{res.get('path')}  {res.get('width')}x{res.get('height')}  {res.get('size')} bytes")
        return
    import base64
    out = args.out or f"wlt-shot-{time.strftime('%Y%m%d_%H%M%S')}.png"
    Path(out).write_bytes(base64.b64decode(res.get("b64", "")))
    print(f"saved {out}  ({res.get('width')}x{res.get('height')}, {res.get('size')} bytes)")
    if res.get("warning"):
        print(f"warning: {res['warning']}", file=sys.stderr)


