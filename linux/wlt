def cmd_ping(_):
    print(json.dumps(api("GET", "/ping"), indent=2, ensure_ascii=False))


def cmd_status(_):
    ping = api("GET", "/ping")
    st = api("GET", "/tunnels/status")
    print(f"agent   : ok  v{ping.get('version')}  host={ping.get('host')}  user={ping.get('user')}")
    c = st.get("control", {})
    u = st.get("user", {})
    print(f"control : {'UP' if c.get('alive') else 'DOWN'}  "
          f"forwards={','.join(c.get('forwards', []))}  "
          f"{('err: ' + c['last_error']) if c.get('last_error') else ''}")
    print(f"user    : {'UP' if u.get('alive') else 'DOWN'}  "
          f"{('err: ' + u['last_error']) if u.get('last_error') else ''}")
    local = load_store()
    lh = hashlib.sha256(json.dumps(local, sort_keys=True, ensure_ascii=False).encode()).hexdigest()[:16]
    if lh != st.get("rules_hash"):
        print(f"rules   : DRIFT (local {lh} != windows {st.get('rules_hash')}) - run: wlt tunnel sync")
    else:
        print(f"rules   : in sync ({lh})")
    print_rule_table(st.get("rules", []))


def cmd_doctor(_):
    print(json.dumps(api("GET", "/doctor"), indent=2, ensure_ascii=False))


def cmd_run(args):
    body = {"cmd": " ".join(args.cmd), "timeout": args.timeout}
    if args.shell:
        body["shell"] = args.shell
    if args.cwd:
        body["cwd"] = args.cwd
    res = api("POST", "/run", body)
    if args.json:
        print(json.dumps(res, indent=2, ensure_ascii=False))
        return
    if not res.get("ok"):
        die(f"{res.get('error_code')}: {res.get('detail', '')}", 126)
    if res.get("out"):
        sys.stdout.write(res["out"])
        if not res["out"].endswith("\n"):
            sys.stdout.write("\n")
    if res.get("err"):
        sys.stderr.write(res["err"])
    if res.get("timed_out"):
        die(f"command timed out after {args.timeout}s (process killed)", 124)
    rc = res.get("rc")
    sys.exit(0 if rc == 0 else (rc or 1))


def cmd_tunnel_add(args):
    rules = load_store()
    rid = args.id or f"{args.dir.lower()}{norm_hostport(args.listen).rsplit(':',1)[1]}"
    rules.append({
        "id": rid, "dir": args.dir.upper(), "listen": args.listen,
        "target": args.target, "enabled": True, "lan": args.lan, "note": args.note or "",
    })
    try:
        rules, opts, result = commit_rules(rules, "add")
    except ValueError as exc:
        die(str(exc), 2)
    print(f"added rule '{rid}'")
    show_apply_result(result)


def cmd_tunnel_list(_):
    st = api("GET", "/tunnels/status")
    print_rule_table(st.get("rules", []))


def _mutate(args, action, fn):
    rules = load_store()
    found = False
    for r in rules:
        if r.get("id") == args.id:
            fn(r)
            found = True
    if not found:
        die(f"no such rule: {args.id}", 2)
    if action == "rm":
        rules = [r for r in rules if r.get("id") != args.id]
    try:
        rules, opts, result = commit_rules(rules, action)
    except ValueError as exc:
        die(str(exc), 2)
    print(f"{action}: {args.id}")
    show_apply_result(result)


def cmd_tunnel_on(args):
    _mutate(args, "on", lambda r: r.update(enabled=True))


def cmd_tunnel_off(args):
    _mutate(args, "off", lambda r: r.update(enabled=False))


def cmd_tunnel_rm(args):
    _mutate(args, "rm", lambda r: None)


def cmd_tunnel_sync(_):
    rules = load_store()
    try:
        rules, opts, result = commit_rules(rules, "sync")
    except ValueError as exc:
        die(str(exc), 2)
    print("synced rule store -> authorized_keys -> Windows")
    show_apply_result(result)


def cmd_tunnel_import(_):
    """Receive a full rule set on stdin (called by Windows over the mgmt key).
    Validates + persists + rewrites authorized_keys. Does NOT push back."""
    try:
        data = json.loads(sys.stdin.read())
    except ValueError as exc:
        die(f"import: bad JSON: {exc}", 2)
    rules = data.get("rules", data if isinstance(data, list) else [])
    try:
        rules, opts, _ = commit_rules(rules, "import", source="gui", push=False)
    except ValueError as exc:
        die(f"import: {exc}", 2)
    print(json.dumps({"ok": True, "count": len(rules),
                      "hash": hashlib.sha256(
                          json.dumps(rules, sort_keys=True, ensure_ascii=False).encode()).hexdigest()[:16]}))


def cmd_tunnel_probe(args):
    rules = load_store()
    r = next((x for x in rules if x.get("id") == args.id), None)
    if not r:
        die(f"no such rule: {args.id}", 2)
    if r["dir"] == "R":
        # listen is on Linux: connecting exercises the full tunnel to Windows.
        host, port = r["listen"].rsplit(":", 1)
        label = f"end-to-end via Linux listen {r['listen']}"
    else:
        # listen is on Windows; from Linux we can only check the target service.
        host, port = r["target"].rsplit(":", 1)
        label = f"target-side check {r['target']} (tunnel listen is on Windows)"
    try:
        with socket.create_connection((host, int(port)), timeout=5):
            print(f"probe {args.id}: OK  ({label})")
    except OSError as exc:
        die(f"probe {args.id}: FAIL  ({label}): {exc}", 1)


