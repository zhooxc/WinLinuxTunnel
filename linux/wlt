    _input({"action": "wheel", "delta": args.delta})


def cmd_drag(args):
    _input({"action": "drag", "x1": args.x1, "y1": args.y1, "x2": args.x2, "y2": args.y2})


def cmd_windows(args):
    res = api("GET", "/windows")
    wins = res.get("windows", [])
    if args.json:
        print(json.dumps(wins, indent=2, ensure_ascii=False))
        return
    print(f"  {'HWND':<12}{'PID':<8}{'PROCESS':<24}TITLE")
    for w in wins:
        print(f"  {w.get('hwnd',''):<12}{w.get('pid',''):<8}"
              f"{w.get('process','')[:22]:<24}{w.get('title','')[:60]}")


def cmd_focus(args):
    body = {"action": "focus"}
    if args.hwnd:
        body["hwnd"] = args.hwnd
    elif args.title:
        body["title"] = args.title
    else:
        die("provide --title or --hwnd", 2)
    print(json.dumps(api("POST", "/window", body), ensure_ascii=False))


def cmd_wait_window(args):
    res = api("POST", "/wait-window", {"title": args.title, "timeout": args.timeout})
    if res.get("found"):
        print(f"found: {res['window'].get('title')} (hwnd={res['window'].get('hwnd')})")
    else:
        die(f"no window matching '{args.title}' within {args.timeout}s", 1)


def cmd_copy(_):
    res = api("POST", "/clipboard", {"op": "get"})
    sys.stdout.write(res.get("text", ""))


def cmd_paste(args):
    res = api("POST", "/clipboard", {"op": "set", "text": " ".join(args.text)})
    print(f"clipboard set ({res.get('length')} chars)")


def cmd_http(args):
    body = {"url": args.url, "method": args.method}
    if args.body:
        body["body"] = args.body
    if args.header:
        body["headers"] = dict(h.split(":", 1) for h in args.header)
    res = api("POST", "/http", body)
    print(f"HTTP {res.get('status')}  ({res.get('size')} bytes)")
    if res.get("text") is not None:
        print(res["text"])
    else:
        print(f"[binary, b64 {len(res.get('b64',''))} chars]")


# --------------------------------------------------------------------------
# Files
# --------------------------------------------------------------------------

def cmd_ls(args):
    res = api("POST", "/fs", {"op": "list", "path": args.path or "."})
    print(f"{res.get('path')}  ({res.get('count')} entries)")
    for e in res.get("entries", []):
        print(f"  {e['type']:<5}{e['size']:>12}  {e['mtime']}  {e['name']}")


def cmd_get(args):
    import base64
    res = api("POST", "/file", {"path": args.remote})
    local = args.local or Path(args.remote.replace("\\", "/")).name
    Path(local).write_bytes(base64.b64decode(res.get("b64", "")))
    print(f"got {res.get('path')} -> {local}  ({res.get('size')} bytes)")


def cmd_put(args):
    import base64
    raw = Path(args.local).read_bytes()
    remote = args.remote or Path(args.local).name
    res = api("POST", "/fs", {"op": "write", "path": remote,
                              "b64": base64.b64encode(raw).decode("ascii")})
    print(f"put {args.local} -> {res.get('path')}  ({res.get('size')} bytes)")


def cmd_rm(args):
    res = api("POST", "/fs", {"op": "rm", "path": args.path, "recursive": args.recursive})
    print(f"removed {res.get('path')}")


def cmd_open(args):
    target = " ".join(args.target)
    res = api("POST", "/run", {"cmd": f'start "" "{target}"', "timeout": 15})
    print(f"opened: {target}  (rc={res.get('rc')})")


# --------------------------------------------------------------------------
# Argument parsing
# --------------------------------------------------------------------------

def build_parser():
    p = argparse.ArgumentParser(prog="wlt", description="wlt - Linux terminal -> Windows desktop + tunnels")
    p.add_argument("--version", action="version", version=f"wlt {VERSION}")
    sub = p.add_subparsers(dest="command", required=True)

    sub.add_parser("ping", help="agent identity").set_defaults(fn=cmd_ping)
    sub.add_parser("status", help="tunnel / agent / rule health").set_defaults(fn=cmd_status)
    sub.add_parser("doctor", help="full environment report").set_defaults(fn=cmd_doctor)

    pr = sub.add_parser("run", help="run a command on Windows")
    pr.add_argument("cmd", nargs="+", help="command line")
    pr.add_argument("--shell", choices=["cmd", "powershell"], default=None)
    pr.add_argument("--timeout", type=float, default=120)
    pr.add_argument("--cwd", default=None)
    pr.add_argument("--json", action="store_true")
    pr.set_defaults(fn=cmd_run)

    pt = sub.add_parser("tunnel", help="manage bidirectional tunnel rules")
    tsub = pt.add_subparsers(dest="tcommand", required=True)

    pa = tsub.add_parser("add", help="add a rule: add L|R <listen> <target>")
    pa.add_argument("dir", choices=["L", "R", "l", "r"])
    pa.add_argument("listen", help="listen port or host:port (on Windows for L, on Linux for R)")
    pa.add_argument("target", help="target host:port (resolved from Linux for L, from Windows for R)")
    pa.add_argument("--id", default=None)
    pa.add_argument("--note", default=None)
    pa.add_argument("--lan", action="store_true", help="allow non-loopback listen")
    pa.set_defaults(fn=cmd_tunnel_add)

    tsub.add_parser("list", help="list rules with live state").set_defaults(fn=cmd_tunnel_list)
    tsub.add_parser("sync", help="push source of truth to Windows").set_defaults(fn=cmd_tunnel_sync)
    tsub.add_parser("import", help="import rule set from stdin (Windows use)").set_defaults(fn=cmd_tunnel_import)

    for name, fn, hlp in (("on", cmd_tunnel_on, "enable a rule"),
                          ("off", cmd_tunnel_off, "disable a rule"),
                          ("rm", cmd_tunnel_rm, "remove a rule"),
                          ("probe", cmd_tunnel_probe, "probe a rule end-to-end")):
        sp = tsub.add_parser(name, help=hlp)
        sp.add_argument("id")
        sp.set_defaults(fn=fn)

    # -- jobs --------------------------------------------------------------
    pj = sub.add_parser("job", help="persistent job control")
    jsub = pj.add_subparsers(dest="jcommand", required=True)
    js = jsub.add_parser("start", help="start a job (returns immediately)")
    js.add_argument("cmd", nargs="+")
    js.add_argument("--shell", choices=["cmd", "powershell", "none"])
    js.add_argument("--timeout", type=float, default=120)
    js.add_argument("--wait", type=float, default=0, help="also wait up to N seconds")
    js.add_argument("--cwd", dest="cwd")
    js.add_argument("--request-id", dest="request_id")
    js.add_argument("--resource")
    js.add_argument("--note")
    js.add_argument("--json", action="store_true")
    js.set_defaults(fn=cmd_job_start)
    jt = jsub.add_parser("status", help="job state (optionally wait)")
    jt.add_argument("id")
    jt.add_argument("--wait", type=float, default=0)
    jt.add_argument("--json", action="store_true")
    jt.set_defaults(fn=cmd_job_status)
    jl = jsub.add_parser("logs", help="read job output by byte cursor")
    jl.add_argument("id")
    jl.add_argument("--which", choices=["stdout", "stderr"], default="stdout")
    jl.add_argument("--since", type=int, default=0)
    jl.add_argument("--limit", type=int, default=65536)
    jl.set_defaults(fn=cmd_job_logs)
    jr = jsub.add_parser("result", help="bounded summary + sha256")
    jr.add_argument("id")
    jr.add_argument("--json", action="store_true")
    jr.set_defaults(fn=cmd_job_result)
    jc = jsub.add_parser("cancel", help="kill the job's process tree")
    jc.add_argument("id")
    jc.add_argument("--note")
    jc.set_defaults(fn=cmd_job_cancel)
    jls = jsub.add_parser("list", help="list recent jobs")
    jls.add_argument("--limit", type=int, default=50)
    jls.set_defaults(fn=cmd_job_list)
    jsub.add_parser("stats", help="job statistics").set_defaults(fn=cmd_job_stats)

    pb = sub.add_parser("batch", help="run a plan file sequentially")
    pb.add_argument("--file", required=True)
    pb.add_argument("--timeout", type=float, default=120)
    pb.set_defaults(fn=cmd_batch)

    # -- desktop -----------------------------------------------------------
    ps = sub.add_parser("shot", help="screenshot (saved locally by default)")
    ps.add_argument("--out")
    ps.add_argument("--monitor", type=int)
    ps.add_argument("--region", help="x,y,w,h")
    ps.add_argument("--window", help="hwnd")
    ps.add_argument("--path-only", action="store_true")
    ps.set_defaults(fn=cmd_shot)
    sub.add_parser("monitors", help="list physical monitors").set_defaults(fn=cmd_monitors)

    pc = sub.add_parser("click", help="click at x y")
    pc.add_argument("x", type=int); pc.add_argument("y", type=int)
    pc.add_argument("--double", action="store_true")
    pc.add_argument("--right", action="store_true")
    pc.add_argument("--middle", action="store_true")
    pc.set_defaults(fn=cmd_click)
    pm = sub.add_parser("move", help="move cursor")
    pm.add_argument("x", type=int); pm.add_argument("y", type=int)
    pm.set_defaults(fn=cmd_move)
    pty = sub.add_parser("type", help="type text")
    pty.add_argument("text", nargs="+")
    pty.set_defaults(fn=cmd_type)
    pk = sub.add_parser("key", help="press a key combo, e.g. ctrl+s")
    pk.add_argument("combo")
    pk.add_argument("--repeat", type=int, default=1)
    pk.set_defaults(fn=cmd_key)
    psc = sub.add_parser("scroll", help="mouse wheel delta (120 = one notch)")
    psc.add_argument("delta", type=int)
    psc.set_defaults(fn=cmd_scroll)
    pd = sub.add_parser("drag", help="drag from x1 y1 to x2 y2")
    pd.add_argument("x1", type=int); pd.add_argument("y1", type=int)
    pd.add_argument("x2", type=int); pd.add_argument("y2", type=int)
    pd.set_defaults(fn=cmd_drag)

    pw = sub.add_parser("windows", help="list visible windows")
    pw.add_argument("--json", action="store_true")
    pw.set_defaults(fn=cmd_windows)
    pf = sub.add_parser("focus", help="focus a window")
    pf.add_argument("--title"); pf.add_argument("--hwnd")
    pf.set_defaults(fn=cmd_focus)
    pww = sub.add_parser("wait-window", help="wait for a window title to appear")
    pww.add_argument("title")
    pww.add_argument("--timeout", type=float, default=30)
    pww.set_defaults(fn=cmd_wait_window)

    sub.add_parser("copy", help="read Windows clipboard").set_defaults(fn=cmd_copy)
    pp = sub.add_parser("paste", help="set Windows clipboard")
    pp.add_argument("text", nargs="+")
    pp.set_defaults(fn=cmd_paste)
    ph = sub.add_parser("http", help="call a Windows-local HTTP service")
    ph.add_argument("url")
    ph.add_argument("--method", default="GET")
    ph.add_argument("--body")
    ph.add_argument("--header", action="append")
    ph.set_defaults(fn=cmd_http)

    # -- files -------------------------------------------------------------
    pls = sub.add_parser("ls", help="list a Windows directory (whitelisted)")
    pls.add_argument("path", nargs="?")
    pls.set_defaults(fn=cmd_ls)
    pg = sub.add_parser("get", help="pull a Windows file to Linux")
    pg.add_argument("remote"); pg.add_argument("local", nargs="?")
    pg.set_defaults(fn=cmd_get)
    ppu = sub.add_parser("put", help="push a Linux file to Windows")
    ppu.add_argument("local"); ppu.add_argument("remote", nargs="?")
    ppu.set_defaults(fn=cmd_put)
    prm = sub.add_parser("rm", help="remove a Windows file/dir (whitelisted)")
    prm.add_argument("path")
    prm.add_argument("--recursive", action="store_true")
    prm.set_defaults(fn=cmd_rm)
    po = sub.add_parser("open", help="open a path or URL on Windows")
    po.add_argument("target", nargs="+")
    po.set_defaults(fn=cmd_open)

    return p


def main():
    args = build_parser().parse_args()
    args.fn(args)


if __name__ == "__main__":
    main()