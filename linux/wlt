def cmd_batch(args):
    """Run a plan file sequentially; stop on first failure. Resource keys are
    enforced agent-side, so concurrent batches sharing a resource serialize."""
    plan = json.loads(Path(args.file).read_text(encoding="utf-8"))
    steps = plan.get("steps", [])
    for i, step in enumerate(steps):
        body = dict(step)
        body.setdefault("timeout", args.timeout)
        res = api("POST", "/job/start", body)
        if not res.get("ok"):
            die(f"step {i}: {res.get('error_code')}: {res.get('detail','')}", 126)
        jid = res["id"]
        print(f"[{i+1}/{len(steps)}] job {jid} started")
        st = api("POST", "/job/status", {"job_id": jid, "wait": args.timeout + 30})
        if st.get("state") != "SUCCEEDED":
            die(f"step {i} (job {jid}) ended {st.get('state')} "
                f"exit={st.get('exit_code')} error={st.get('error_code')}", 1)
    print(f"batch complete: {len(steps)} step(s) succeeded")


